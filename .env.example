# Copy to .env and fill in. Never commit .env.

# --- Gmail (Phase 1) ---
# Path to the OAuth client file downloaded from Google Cloud (Desktop app).
# Default: ~/.config/jobagent/credentials.json (outside iCloud-synced folders)
GMAIL_CREDENTIALS_PATH=
# Where the OAuth token is cached after first login.
# Default: ~/.config/jobagent/token.json
GMAIL_TOKEN_PATH=
# Gmail search query used by `inbox sync` (date filter is added by --since).
GMAIL_QUERY=

# --- Storage ---
# Default: ~/.local/share/jobagent/jobagent.db (outside iCloud-synced folders)
DB_PATH=

# --- LLM ---
# Local model for classification/extraction.
OLLAMA_HOST=http://localhost:11434
# Default: qwen3:8b
INBOX_MODEL=
# Hosted model, only used for tasks explicitly enabled below.
ANTHROPIC_API_KEY=
# Comma-separated tasks allowed to send content to the hosted model (empty = none).
HOSTED_MODEL_TASKS=
